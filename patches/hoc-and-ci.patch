diff --git a/scripts/build_gpu_ios.sh b/scripts/build_gpu_ios.sh
index f8d2c65..832e757 100755
--- a/scripts/build_gpu_ios.sh
+++ b/scripts/build_gpu_ios.sh
@@ -18,18 +18,25 @@ HUSK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
 GPU="$HUSK_ROOT/third_party/gpu"
 PREFIX="$HUSK_ROOT/build/ios-arm64/sysroot"
 LOGS="$HUSK_ROOT/build/logs"
-MESON=/opt/homebrew/bin/meson
-NINJA=/opt/homebrew/bin/ninja
+MESON="$(command -v meson)"
+NINJA="$(command -v ninja)"
 mkdir -p "$GPU" "$LOGS"
 
 EPOXY_COMMIT=bf98587477fe68d07b93319ece7b40a7d0e2eabe
 VIRGL_COMMIT=482f9d8b8c2d2288efa10a027116216909d2c226
 
+# Prefer a reachable GitHub front when github.com times out (common on CN nets).
+GITHUB_MIRROR="${GITHUB_MIRROR:-https://ghproxy.net/https://github.com}"
+
 fetch () {
     local dir="$1"
     local url="$2"
     local commit="$3"
-    [ -d "$GPU/$dir" ] || git clone -q "$url" "$GPU/$dir"
+    local mirrored="${url/https:\/\/github.com/$GITHUB_MIRROR}"
+    if [ ! -d "$GPU/$dir" ]; then
+        git clone "$mirrored" "$GPU/$dir" \
+          || git clone "$url" "$GPU/$dir"
+    fi
     ( cd "$GPU/$dir" && git checkout -q "$commit" )
 }
 
